# LiteLLM gateway
LITELLM_MASTER_KEY=sk-REPLACE-with-64-char-hex
LITELLM_SALT_KEY=sk-REPLACE-with-64-char-hex

# Postgres
POSTGRES_USER=litellm
POSTGRES_DB=litellm
POSTGRES_PASSWORD=REPLACE-me
DATABASE_URL=postgresql://litellm:REPLACE-me@postgres:5432/litellm

# AWS Bedrock (Phase 2 — IAM user path; replaced by instance role in Phase 5/6)
AWS_ACCESS_KEY_ID=REPLACE-me
AWS_SECRET_ACCESS_KEY=REPLACE-me
AWS_REGION=us-east-1
